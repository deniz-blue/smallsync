{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Store",
	"description": "GET /",
	"type": "object",
	"required": [
		"$type",
		"uuid",
		"sse",
		"scopes"
	],
	"properties": {
		"$type": {
			"const": "blue.deniz.smallsync#0"
		},
		"uuid": {
			"type": "string",
			"format": "uuid",
			"description": "The store's id. A store that starts over, empty or from a backup, gets a new one."
		},
		"sse": {
			"type": "boolean",
			"description": "Whether /subscribe exists."
		},
		"scopes": {
			"type": "array",
			"description": "What the request may do, with its token or without one.",
			"items": {
				"type": "string"
			}
		}
	}
}
