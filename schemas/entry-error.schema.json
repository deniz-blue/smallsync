{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Entry error",
	"description": "Why a pushed entry was refused, in place of its seq.",
	"type": "object",
	"required": [
		"error",
		"message"
	],
	"properties": {
		"error": {
			"enum": [
				"missing",
				"test-failed",
				"patch-failed"
			]
		},
		"message": {
			"type": "string"
		}
	}
}
