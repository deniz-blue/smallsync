{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Entry",
	"type": "object",
	"required": [
		"seq",
		"op",
		"type",
		"id",
		"at"
	],
	"properties": {
		"seq": {
			"type": "integer",
			"minimum": 1
		},
		"op": {
			"enum": [
				"create",
				"update",
				"delete"
			]
		},
		"type": {
			"$ref": "record-type.schema.json"
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"value": {},
		"at": {
			"type": "integer",
			"description": "When the server appended the entry, in Unix milliseconds."
		}
	},
	"additionalProperties": false,
	"allOf": [
		{
			"if": {
				"properties": {
					"op": {
						"const": "create"
					}
				}
			},
			"then": {
				"required": [
					"value"
				]
			}
		},
		{
			"if": {
				"properties": {
					"op": {
						"const": "update"
					}
				}
			},
			"then": {
				"required": [
					"value"
				],
				"properties": {
					"value": {
						"$ref": "json-patch.schema.json"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"op": {
						"const": "delete"
					}
				}
			},
			"then": {
				"not": {
					"required": [
						"value"
					]
				}
			}
		}
	]
}
