{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Entry to push",
	"type": "object",
	"required": [
		"op",
		"type",
		"id"
	],
	"properties": {
		"key": {
			"type": "string",
			"minLength": 1,
			"description": "Unique to this entry. When the server already has an entry with this key, it answers with that entry's seq and applies nothing."
		},
		"op": {
			"enum": [
				"set",
				"patch",
				"delete"
			]
		},
		"type": {
			"$ref": "record-type.schema.json"
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"value": {}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"op": {
						"const": "set"
					}
				}
			},
			"then": {
				"required": [
					"value"
				]
			}
		},
		{
			"if": {
				"properties": {
					"op": {
						"const": "patch"
					}
				}
			},
			"then": {
				"required": [
					"value"
				],
				"properties": {
					"value": {
						"$ref": "json-patch.schema.json"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"op": {
						"const": "delete"
					}
				}
			},
			"then": {
				"not": {
					"required": [
						"value"
					]
				}
			}
		}
	]
}
