{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Request error",
	"description": "The body of a failed request.",
	"type": "object",
	"required": [
		"error",
		"message"
	],
	"properties": {
		"error": {
			"enum": [
				"invalid",
				"unauthorized",
				"forbidden",
				"not-found",
				"too-large"
			]
		},
		"message": {
			"type": "string"
		}
	}
}
